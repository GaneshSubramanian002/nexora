/* =========================================================
   SEARCH CANDIDATES
========================================================= */

async function searchCandidates() {

    const queryInput =
        document.getElementById("jobQuery");

    const button =
        document.getElementById("searchButton");

    const query =
        queryInput.value.trim();


    if (!query) {

        alert(
            "Please enter a job description or hiring requirement."
        );

        queryInput.focus();

        return;
    }


    currentQuery = query;


    button.disabled = true;

    button.innerText = "Analyzing...";


    showPage("results");


    document.getElementById("resultsContent").innerHTML = `

        <div class="loading">

            Analyzing resumes and ranking candidates...

        </div>

    `;


    try {

        const response = await fetch(
            "/api/candidates?query=" +
            encodeURIComponent(query)
        );


        const data = await response.json();


        if (!response.ok) {

            throw new Error(
                data.error || "Could not fetch candidates."
            );

        }


        backendData = Array.isArray(data)
            ? data
            : [];


        if (!backendData.length) {

            document.getElementById(
                "resultsContent"
            ).innerHTML = `

                <div class="error-box">

                    No candidates were found for this search.

                </div>

            `;

            return;
        }


        renderResults();

        updateDashboard();

    }

    catch (error) {

        console.error(error);


        document.getElementById(
            "resultsContent"
        ).innerHTML = `

            <div class="error-box">

                <strong>
                    Could not load candidates.
                </strong>

                <br><br>

                ${escapeHtml(error.message)}

                <br><br>

                Make sure Flask is running on
                <strong>http://127.0.0.1:5001</strong>.

            </div>

        `;

    }

    finally {

        button.disabled = false;

        button.innerText = "Find Candidates →";

    }

}



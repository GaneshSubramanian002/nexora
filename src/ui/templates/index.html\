<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Nexora | Intelligent Recruitment</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
                         Roboto, Helvetica, Arial, sans-serif;
            background: #f6f4ef;
            color: #172033;
            min-height: 100vh;
        }

        button,
        input,
        textarea {
            font-family: inherit;
        }

        button {
            cursor: pointer;
        }

        /* =========================
           NAVBAR
        ========================= */

        nav {
            height: 72px;
            background: #ffffff;
            border-bottom: 1px solid #e4dfd6;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 7%;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-size: 23px;
            font-weight: 750;
            letter-spacing: -0.5px;
            color: #172033;
        }

        .logo span {
            color: #7b6d5c;
        }

        .nav-links {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .nav-links button {
            border: none;
            background: none;
            color: #687181;
            font-size: 14px;
            padding: 8px 0;
            transition: 0.2s;
        }

        .nav-links button:hover,
        .nav-links button.active {
            color: #172033;
        }

        /* =========================
           PAGE SYSTEM
        ========================= */

        .page {
            display: none;
        }

        .page.active {
            display: block;
        }

        /* =========================
           HOME
        ========================= */

        .hero {
            max-width: 1050px;
            margin: auto;
            padding: 95px 25px 80px;
            text-align: center;
        }

        .hero-tag {
            display: inline-block;
            background: #ebe6dd;
            color: #746957;
            border-radius: 30px;
            padding: 7px 14px;
            font-size: 12px;
            font-weight: 650;
            margin-bottom: 22px;
        }

        .hero h1 {
            font-size: clamp(42px, 6vw, 72px);
            line-height: 1.05;
            letter-spacing: -3px;
            margin-bottom: 22px;
        }

        .hero h1 span {
            color: #7b6d5c;
        }

        .hero p {
            max-width: 680px;
            margin: auto;
            color: #697180;
            font-size: 17px;
            line-height: 1.7;
        }

        .search-card {
            max-width: 850px;
            margin: 42px auto 0;
            background: #ffffff;
            border: 1px solid #ded8ce;
            border-radius: 18px;
            padding: 22px;
            box-shadow: 0 12px 35px rgba(31, 37, 48, 0.06);
        }

        .search-card textarea {
            width: 100%;
            min-height: 130px;
            border: 1px solid #ddd7cd;
            border-radius: 12px;
            resize: vertical;
            padding: 16px;
            outline: none;
            font-size: 15px;
            color: #172033;
            background: #fbfaf8;
        }

        .search-card textarea:focus {
            border-color: #aaa093;
        }

        .search-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 16px;
            gap: 15px;
        }

        .search-hint {
            color: #858c97;
            font-size: 13px;
            text-align: left;
        }

        .primary-button {
            background: #172033;
            color: #ffffff;
            border: none;
            border-radius: 10px;
            padding: 12px 22px;
            font-size: 14px;
            font-weight: 650;
            transition: 0.2s;
        }

        .primary-button:hover {
            background: #2b3547;
            transform: translateY(-1px);
        }

        .primary-button:disabled {
            opacity: 0.55;
            cursor: not-allowed;
            transform: none;
        }

        .upload-area {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #ece7df;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .upload-button {
            background: #ffffff;
            color: #172033;
            border: 1px solid #d8d2c8;
            padding: 11px 20px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 650;
            transition: 0.2s;
        }

        .upload-button:hover {
            background: #eee9df;
        }

        .upload-button:disabled {
            opacity: 0.55;
            cursor: not-allowed;
        }

        #uploadStatus {
            color: #7c8593;
            font-size: 13px;
            max-width: 350px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .examples {
            margin-top: 18px;
            display: flex;
            justify-content: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .example {
            border: 1px solid #ddd7cd;
            background: #fbfaf8;
            color: #6e7560;
            border-radius: 20px;
            padding: 7px 12px;
            font-size: 12px;
            cursor: pointer;
        }

        .example:hover {
            background: #eee9df;
        }

        /* =========================
           GENERIC PAGE HEADER
        ========================= */

        .page-container {
            max-width: 1120px;
            margin: auto;
            padding: 65px 25px 80px;
        }

        .page-header {
            margin-bottom: 35px;
        }

        .page-header h1 {
            font-size: 38px;
            letter-spacing: -1.5px;
            margin-bottom: 8px;
        }

        .page-header p {
            color: #747d8c;
            line-height: 1.6;
        }

        /* =========================
           RESULTS
        ========================= */

        .search-summary {
            background: #ffffff;
            border: 1px solid #ded8ce;
            border-radius: 13px;
            padding: 16px 18px;
            margin-bottom: 28px;
        }

        .search-summary-label {
            color: #8a909b;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.7px;
            margin-bottom: 7px;
        }

        .search-summary-text {
            color: #273143;
            font-size: 15px;
            line-height: 1.5;
        }

        .section-heading {
            font-size: 20px;
            margin-bottom: 15px;
        }

        .top-three {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
            margin-bottom: 45px;
        }

        .candidate-card {
            background: #ffffff;
            border: 1px solid #ded8ce;
            border-radius: 15px;
            padding: 22px;
            transition: 0.2s;
        }

        .candidate-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(31, 37, 48, 0.07);
        }

        .candidate-rank {
            font-size: 12px;
            color: #8a909b;
            margin-bottom: 14px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }

        .candidate-name {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .candidate-email {
            font-size: 12px;
            color: #89909c;
            margin-bottom: 18px;
            word-break: break-word;
        }

        .candidate-score {
            font-size: 32px;
            font-weight: 750;
            margin-bottom: 5px;
        }

        .candidate-score-label {
            color: #858c97;
            font-size: 12px;
            margin-bottom: 17px;
        }

        .mini-score {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            color: #687181;
            margin-top: 8px;
        }

        .mini-score strong {
            color: #273143;
        }

        .view-button {
            width: 100%;
            margin-top: 18px;
            background: #f1eee8;
            color: #172033;
            border: 1px solid #ded8ce;
            border-radius: 9px;
            padding: 10px;
            font-size: 13px;
            font-weight: 650;
        }

        .view-button:hover {
            background: #e8e2d8;
        }

        .candidate-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .list-row {
            background: #ffffff;
            border: 1px solid #e2ddd5;
            border-radius: 12px;
            padding: 15px 18px;
            display: grid;
            grid-template-columns: 60px 1fr 120px 100px;
            align-items: center;
            gap: 15px;
        }

        .list-rank {
            font-weight: 700;
            color: #7b6d5c;
        }

        .list-name {
            font-weight: 650;
        }

        .list-email {
            color: #89909c;
            font-size: 12px;
            margin-top: 3px;
        }

        .list-score {
            font-weight: 700;
        }

        .list-button {
            border: 1px solid #ddd7cd;
            background: #ffffff;
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 12px;
        }

        .list-button:hover {
            background: #f0ece5;
        }

        .loading {
            padding: 50px;
            text-align: center;
            color: #747d8c;
        }

        .error-box {
            background: #fff8f5;
            border: 1px solid #ead4ca;
            color: #8a5747;
            border-radius: 12px;
            padding: 18px;
            line-height: 1.6;
        }

        /* =========================
           DETAILS
        ========================= */

        .back-button {
            background: none;
            border: none;
            color: #737b89;
            font-size: 13px;
            padding: 0;
            margin-bottom: 24px;
        }

        .back-button:hover {
            color: #172033;
        }

        .details-header {
            background: #ffffff;
            border: 1px solid #ded8ce;
            border-radius: 16px;
            padding: 28px;
            display: flex;
            justify-content: space-between;
            gap: 30px;
            align-items: flex-start;
        }

        .details-name {
            font-size: 34px;
            letter-spacing: -1px;
            margin-bottom: 10px;
        }

        .details-rank {
            display: inline-block;
            background: #eee9df;
            color: #706350;
            border-radius: 20px;
            padding: 6px 11px;
            font-size: 12px;
            font-weight: 650;
            margin-bottom: 13px;
        }

        .details-contact {
            color: #777f8d;
            font-size: 13px;
            line-height: 1.8;
        }

        .details-final {
            text-align: right;
            min-width: 150px;
        }

        .score-label {
            color: #8b919c;
            font-size: 11px;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }

        .details-final-number {
            font-size: 42px;
            font-weight: 800;
        }

        .score-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 13px;
            margin-top: 18px;
        }

        .score-box {
            background: #ffffff;
            border: 1px solid #ded8ce;
            border-radius: 13px;
            padding: 18px;
        }

        .score-box-title {
            color: #7d8592;
            font-size: 12px;
            margin-bottom: 10px;
        }

        .score-box-value {
            font-size: 23px;
            font-weight: 750;
        }

        /* =========================
           EXPLANATION
        ========================= */

        .detail-section {
            margin-top: 20px;
            background: #ffffff;
            border: 1px solid #ded8ce;
            border-radius: 15px;
            padding: 24px;
        }

        .detail-section h3 {
            font-size: 18px;
            margin-bottom: 17px;
        }

        .explanation-box {
            background: #f7f4ee;
            border: 1px solid #ded8ce;
            border-radius: 12px;
            padding: 20px;
        }

        .explanation-main {
            font-size: 16px;
            font-weight: 650;
            color: #172033;
            line-height: 1.6;
            margin-bottom: 18px;
        }

        .explanation-points {
            display: grid;
            gap: 10px;
        }

        .explanation-point {
            font-size: 14px;
            color: #596273;
            line-height: 1.5;
        }

        .explanation-point.good {
            color: #536b5b;
        }

        .explanation-point.warning {
            color: #866d52;
        }

        .skill-groups {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .skill-group {
            border: 1px solid #e2ddd5;
            border-radius: 11px;
            padding: 15px;
        }

        .skill-group-title {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.7px;
            color: #7c8490;
            margin-bottom: 11px;
        }

        .skills {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
        }

        .skill {
            display: inline-block;
            background: #f0ece5;
            border: 1px solid #ded8ce;
            color: #4f5969;
            border-radius: 20px;
            padding: 6px 10px;
            font-size: 12px;
        }

        .skill.match {
            background: #edf2ed;
            border-color: #d5e0d6;
            color: #526b59;
        }

        .skill.missing {
            background: #f6eeea;
            border-color: #ead8cf;
            color: #856455;
        }

        .detail-content {
            color: #687181;
            font-size: 14px;
            line-height: 1.75;
            white-space: pre-line;
        }

        .detail-content.empty {
            color: #a0a6af;
            font-style: italic;
        }

        .why-higher {
            background: #172033;
            color: white;
            border-radius: 13px;
            padding: 20px;
        }

        .why-higher h4 {
            font-size: 15px;
            margin-bottom: 10px;
        }

        .why-higher p {
            color: #d7dce3;
            font-size: 13px;
            line-height: 1.7;
        }

        /* =========================
           DASHBOARD
        ========================= */

        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: #ffffff;
            border: 1px solid #ded8ce;
            border-radius: 14px;
            padding: 23px;
        }

        .stat-title {
            color: #818894;
            font-size: 12px;
            margin-bottom: 10px;
        }

        .stat-value {
            font-size: 30px;
            font-weight: 750;
        }

        .dashboard-card {
            background: #ffffff;
            border: 1px solid #ded8ce;
            border-radius: 14px;
            padding: 24px;
            margin-bottom: 20px;
        }

        .dashboard-card h3 {
            margin-bottom: 17px;
        }

        /* =========================
           CONTACT
        ========================= */

        .contact-card {
            max-width: 650px;
            background: #ffffff;
            border: 1px solid #ded8ce;
            border-radius: 16px;
            padding: 30px;
        }

        .contact-card p {
            color: #6f7785;
            line-height: 1.7;
            margin-bottom: 20px;
        }

        .contact-item {
            padding: 15px 0;
            border-bottom: 1px solid #ece7df;
        }

        .contact-item:last-child {
            border-bottom: none;
        }

        .contact-item strong {
            display: block;
            margin-bottom: 4px;
        }

        .contact-item span {
            color: #7b8390;
            font-size: 14px;
        }

        /* =========================
           FOOTER
        ========================= */

        footer {
            border-top: 1px solid #e1dcd4;
            background: #ffffff;
            padding: 25px 7%;
            color: #8a909b;
            font-size: 12px;
            text-align: center;
        }

        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 800px) {
            nav {
                padding: 0 20px;
            }

            .nav-links {
                gap: 13px;
            }

            .nav-links button {
                font-size: 12px;
            }

            .hero {
                padding-top: 65px;
            }

            .search-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .search-hint {
                text-align: center;
            }

            .top-three {
                grid-template-columns: 1fr;
            }

            .score-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .details-header {
                flex-direction: column;
            }

            .details-final {
                text-align: left;
            }

            .skill-groups {
                grid-template-columns: 1fr;
            }

            .list-row {
                grid-template-columns: 45px 1fr 80px;
            }

            .list-button {
                display: none;
            }

            .dashboard-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 500px) {
            .nav-links {
                display: none;
            }

            .score-grid {
                grid-template-columns: 1fr;
            }

            .page-container {
                padding-left: 16px;
                padding-right: 16px;
            }

            .details-name {
                font-size: 28px;
            }
        }
    </style>
</head>

<body>

<!-- =========================
     NAVBAR
========================= -->

<nav>
    <div class="logo">
        Nex<span>ora</span>
    </div>

    <div class="nav-links">
        <button class="active" onclick="showPage('home', this)">Home</button>
        <button onclick="showPage('results', this)">Results</button>
        <button onclick="showPage('dashboard', this)">Dashboard</button>
        <button onclick="showPage('contact', this)">Contact</button>
    </div>
</nav>


<!-- =========================
     HOME
========================= -->

<section id="home" class="page active">

    <div class="hero">

        <div class="hero-tag">
            INTELLIGENT CANDIDATE SHORTLISTING
        </div>

        <h1>
            Find the right<br>
            <span>candidate faster.</span>
        </h1>

        <p>
            Nexora analyzes resumes against your hiring requirements,
            ranks candidates, and explains exactly why each candidate
            received their score.
        </p>


        <div class="search-card">

            <textarea
                id="jobQuery"
                placeholder="Describe the job you're hiring for...

Example:
Python developer with AWS, SQL, REST API and Machine Learning experience."
            ></textarea>

            <div class="search-actions">

                <div class="search-hint">
                    Enter a job description or hiring requirements
                </div>

                <button
                    id="searchButton"
                    class="primary-button"
                    onclick="searchCandidates()"
                >
                    Find Candidates →
                </button>

            </div>


            <div class="examples">

                <button
                    class="example"
                    onclick="useExample('Python developer with AWS and SQL')"
                >
                    Python + AWS + SQL
                </button>

                <button
                    class="example"
                    onclick="useExample('React frontend developer with JavaScript and Node.js')"
                >
                    React Frontend
                </button>

                <button
                    class="example"
                    onclick="useExample('Machine Learning engineer with Python, SQL and TensorFlow')"
                >
                    Machine Learning
                </button>

            </div>


            <div class="upload-area">

                <input
                    type="file"
                    id="resumeInput"
                    accept=".pdf,application/pdf"
                    hidden
                    onchange="uploadResume()"
                >

                <button
                    id="uploadButton"
                    class="upload-button"
                    onclick="document.getElementById('resumeInput').click()"
                >
                    + Add Resume
                </button>

                <span id="uploadStatus">
                    PDF only
                </span>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     RESULTS
========================= -->

<section id="results" class="page">

    <div class="page-container">

        <div class="page-header">

            <h1>Candidate Results</h1>

            <p>
                Candidates ranked according to their match with your
                hiring requirements.
            </p>

        </div>


        <div id="resultsContent">

            <div class="loading">
                Enter a job description on the Home page to begin.
            </div>

        </div>

    </div>

</section>


<!-- =========================
     DETAILS
========================= -->

<section id="details" class="page">

    <div class="page-container">

        <button
            class="back-button"
            onclick="showPage('results')"
        >
            ← Back to results
        </button>

        <div id="candidateDetails"></div>

    </div>

</section>


<!-- =========================
     DASHBOARD
========================= -->

<section id="dashboard" class="page">

    <div class="page-container">

        <div class="page-header">

            <h1>Dashboard</h1>

            <p>
                Overview of your current candidate screening pipeline.
            </p>

        </div>


        <div class="dashboard-grid">

            <div class="stat-card">

                <div class="stat-title">
                    TOTAL CANDIDATES
                </div>

                <div
                    class="stat-value"
                    id="totalCandidates"
                >
                    0
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-title">
                    TOP MATCH
                </div>

                <div
                    class="stat-value"
                    id="topMatch"
                >
                    —
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-title">
                    AVERAGE SCORE
                </div>

                <div
                    class="stat-value"
                    id="averageScore"
                >
                    0%
                </div>

            </div>

        </div>


        <div class="dashboard-card">

            <h3>
                Current Search
            </h3>

            <div
                id="dashboardQuery"
                class="detail-content"
            >
                No search performed yet.
            </div>

        </div>


        <div class="dashboard-card">

            <h3>
                Top Candidate
            </h3>

            <div
                id="dashboardTopCandidate"
                class="detail-content"
            >
                No candidate data available.
            </div>

        </div>

    </div>

</section>


<!-- =========================
     CONTACT
========================= -->

<section id="contact" class="page">

    <div class="page-container">

        <div class="page-header">

            <h1>Contact Us</h1>

            <p>
                Questions about Nexora or the recruitment pipeline?
            </p>

        </div>


        <div class="contact-card">

            <p>
                Nexora is an intelligent recruitment screening prototype
                designed to help recruiters process resumes faster and
                understand why candidates are ranked.
            </p>


            <div class="contact-item">

                <strong>
                    Product
                </strong>

                <span>
                    AI-assisted candidate screening and ranking
                </span>

            </div>


            <div class="contact-item">

                <strong>
                    Support
                </strong>

                <span>
                    Contact your Nexora project team
                </span>

            </div>


            <div class="contact-item">

                <strong>
                    Project
                </strong>

                <span>
                    Nexora Hackathon Recruitment Intelligence
                </span>

            </div>

        </div>

    </div>

</section>


<footer>
    Nexora · Intelligent Recruitment · Hackathon Prototype
</footer>


<script>

/* =========================================================
   GLOBAL STATE
========================================================= */

let backendData = [];

let currentQuery = "";


/* =========================================================
   PAGE NAVIGATION
========================================================= */

function showPage(pageId, clickedButton = null) {

    document
        .querySelectorAll(".page")
        .forEach(page => {
            page.classList.remove("active");
        });


    const page = document.getElementById(pageId);

    if (page) {
        page.classList.add("active");
    }


    document
        .querySelectorAll(".nav-links button")
        .forEach(button => {
            button.classList.remove("active");
        });


    if (clickedButton) {

/* =========================================================
   DASHBOARD
========================================================= */

function updateDashboard() {

    const total =
        backendData.length;


    document.getElementById(
        "totalCandidates"
    ).innerText = total;


    if (!total) {

        document.getElementById(
            "topMatch"
        ).innerText = "—";


        document.getElementById(
            "averageScore"
        ).innerText = "0%";


        return;

    }


    const scores =
        backendData.map(
            candidate =>
                Number(
                    getScores(candidate).final || 0
                )
        );


    const average =
        scores.reduce(
            (sum, score) =>
                sum + score,
            0
        ) / scores.length;


    const top =
        backendData[0];


    document.getElementById(
        "topMatch"
    ).innerText =
        `${Number(
            getScores(top).final || 0
        ).toFixed(2)}%`;


    document.getElementById(
        "averageScore"
    ).innerText =
        `${average.toFixed(2)}%`;


    document.getElementById(
        "dashboardQuery"
    ).innerText =
        currentQuery ||
        "No search performed yet.";


    document.getElementById(
        "dashboardTopCandidate"
    ).innerText =
        top
            ?

            `${top.name || "Unknown Candidate"} · ${Number(
                getScores(top).final || 0
            ).toFixed(2)}%`

            :

            "No candidate data available.";

}


/* =========================================================
   RESUME UPLOAD
========================================================= */

async function uploadResume() {

    const input =
        document.getElementById(
            "resumeInput"
        );


    const status =
        document.getElementById(
            "uploadStatus"
        );


    const button =
        document.getElementById(
            "uploadButton"
        );


    const file =
        input.files[0];


    if (!file) {
        return;
    }


    if (
        !file.name
            .toLowerCase()
            .endsWith(".pdf")
    ) {

        alert(
            "Please select a PDF resume."
        );

        input.value = "";

        return;
    }


    status.innerText =
        "Uploading...";


    button.disabled = true;


    const formData =
        new FormData();


    formData.append(
        "resume",
        file
    );


    try {

        const response =
            await fetch(
                "/api/upload-resume",
                {
                    method: "POST",
                    body: formData
                }
            );


        const data =
            await response.json();


        if (!response.ok) {

            throw new Error(
                data.error ||
                "Upload failed."
            );

        }


        status.innerText =
            `${data.resume.name || file.name} added ✓`;


        alert(
            `Resume uploaded successfully!\n\n` +
            `Candidate: ${
                data.resume.name ||
                "Unknown"
            }\n` +
            `Total candidates: ${
                data.total_candidates
            }`
        );


        input.value = "";


        /*
         * If a search is currently active,
         * automatically rerun it so the
         * newly uploaded candidate appears.
         */

        if (currentQuery) {

            await searchCandidates();

        }

    }

    catch (error) {

        console.error(
            "Resume upload error:",
            error
        );


        status.innerText =
            "Upload failed";


        alert(
            "Could not upload resume.\n\n" +
            error.message
        );

    }

    finally {

        button.disabled = false;

    }

}


/* =========================================================
   HTML ESCAPING
========================================================= */

function escapeHtml(value) {

    return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

}


/* =========================================================
   KEYBOARD SHORTCUT
========================================================= */

document
    .getElementById("jobQuery")
    .addEventListener(
        "keydown",
        function(event) {

            if (
                event.key === "Enter" &&
                (event.metaKey || event.ctrlKey)
            ) {

                searchCandidates();

            }

        }
    );


/* =========================================================
   INITIAL DASHBOARD
========================================================= */

updateDashboard();

</script>


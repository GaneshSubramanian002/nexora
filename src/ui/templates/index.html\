/* =========================================================
   REQUIRED SKILLS FROM JOB QUERY
========================================================= */

function extractRequiredSkills(query) {

    const skillsList = [

        "Python",
        "Java",
        "C",
        "C++",
        "C#",
        "JavaScript",
        "TypeScript",
        "HTML",
        "CSS",
        "React",
        "Angular",
        "Vue",
        "Node.js",
        "Express",
        "Django",
        "Flask",
        "FastAPI",
        "Spring",
        "SQL",
        "MySQL",
        "PostgreSQL",
        "MongoDB",
        "Redis",
        "AWS",
        "Azure",
        "GCP",
        "Docker",
        "Kubernetes",
        "Git",
        "GitHub",
        "REST API",
        "GraphQL",
        "Machine Learning",
        "Deep Learning",
        "TensorFlow",
        "PyTorch",
        "Pandas",
        "NumPy",
        "scikit-learn",
        "Linux",
        "Firebase",
        "Tailwind",
        "Bootstrap"

    ];


    return skillsList.filter(
        skill =>
            query
                .toLowerCase()
                .includes(skill.toLowerCase())
    );

}


/* =========================================================
   NORMALIZE SKILL
========================================================= */

function normalizeSkill(skill) {

    return skill
        .toLowerCase()
        .replace(".js", "")
        .replace("javascript", "javascript")
        .replace("react.js", "react")
        .replace("nodejs", "node")
        .replace("node.js", "node")
        .replace("rest apis", "rest api")
        .trim();

}


/* =========================================================
   MATCHED / MISSING SKILLS
========================================================= */

function getSkillAnalysis(candidate) {

    const requiredSkills =
        extractRequiredSkills(
            currentQuery
        );


    const candidateSkills =
        candidate.skills || [];


    const candidateNormalized =
        candidateSkills.map(
            skill => normalizeSkill(skill)
        );


    const matched = [];

    const missing = [];


    requiredSkills.forEach(
        requiredSkill => {

            const normalizedRequired =
                normalizeSkill(requiredSkill);


            const found =
                candidateNormalized.some(
                    candidateSkill =>
                        candidateSkill ===
                        normalizedRequired
                );


            if (found) {

                matched.push(requiredSkill);

            } else {

                missing.push(requiredSkill);

            }

        }
    );


    return {

        required: requiredSkills,

        matched,

        missing

    };

}


/* =========================================================
   RANKING EXPLANATION
========================================================= */

function getRankingExplanation(candidate) {

    const scores =
        getScores(candidate);


    const finalScore =
        Number(scores.final || 0);

    const semantic =
        Number(scores.semantic || 0);

    const required =
        Number(scores.required || 0);

    const keyword =
        Number(scores.keyword || 0);

    const experience =
        Number(scores.experience || 0);


    const analysis =
        getSkillAnalysis(candidate);


    const matchedCount =
        analysis.matched.length;


    const requiredCount =
        analysis.required.length;


    if (
        requiredCount > 0 &&
        matchedCount === requiredCount &&
        experience > 0
    ) {

        return `
            This candidate ranked highly because they match
            all detected required skills and also have
            relevant experience.
        `;

    }


    if (
        requiredCount > 0 &&
        matchedCount === requiredCount
    ) {

        return `
            This candidate ranked highly because they match
            all of the technical skills detected from the
            job requirements.
        `;

    }


    if (semantic >= 70) {

        return `
            This candidate ranked highly because the content
            of their resume strongly aligns with the job
            description.
        `;

    }


    if (experience >= 60) {

        return `
            This candidate ranked highly because they have
            strong relevant experience in addition to their
            technical match.
        `;

    }


    if (finalScore >= 50) {

        return `
            This candidate achieved a strong overall score
            across the technical, semantic, and experience
            criteria.
        `;

    }


    return `
        This candidate has relevant skills and resume content,
        but there are still areas where the profile does not
        fully match the job requirements.
    `;

}


/* =========================================================
   EXPLANATION POINTS
========================================================= */

function getExplanationPoints(candidate) {

    const scores =
        getScores(candidate);


    const semantic =
        Number(scores.semantic || 0);

    const required =
        Number(scores.required || 0);

    const keyword =
        Number(scores.keyword || 0);

    const experience =
        Number(scores.experience || 0);


    const analysis =
        getSkillAnalysis(candidate);


    const points = [];


    if (analysis.required.length > 0) {

        if (
            analysis.matched.length ===
            analysis.required.length
        ) {

            points.push({
                type: "good",
                text:
                    `✓ Matches all ${analysis.required.length} detected required skills`
            });

        } else {

            points.push({
                type: "warning",
                text:
                    `⚠ Matches ${analysis.matched.length} of ${analysis.required.length} detected required skills`
            });

        }

    } else {

        points.push({
            type: "good",
            text:
                "✓ No specific technical skills were explicitly detected from the search"
        });

    }


    if (semantic >= 70) {

        points.push({
            type: "good",
            text:
                "✓ Strong alignment with the job description"
        });

    } else if (semantic >= 50) {

        points.push({
            type: "good",
            text:
                "✓ Moderate alignment with the job description"
        });

    } else {

        points.push({
            type: "warning",
            text:
                "⚠ Limited semantic alignment with the job description"
        });

    }


    if (keyword >= 70) {

        points.push({
            type: "good",
            text:
                "✓ Strong technical keyword overlap"
        });

    } else if (keyword >= 40) {

        points.push({
            type: "good",
            text:
                "✓ Some relevant technical keywords detected"
        });

    } else {

        points.push({
            type: "warning",
            text:
                "⚠ Limited keyword overlap"
        });

    }


    if (experience >= 60) {

        points.push({
            type: "good",
            text:
                "✓ Strong relevant experience detected"
        });

    } else if (experience > 0) {

        points.push({
            type: "good",
            text:
                "✓ Some relevant experience detected"
        });

    } else {

        points.push({
            type: "warning",
            text:
                "⚠ No formal experience detected"
        });

    }


    return points
        .map(
            point => `
                <div class="explanation-point ${point.type}">
                    ${point.text}
                </div>
            `
        )
        .join("");

}


/* =========================================================
   WHY THIS CANDIDATE IS ABOVE NEXT CANDIDATE
========================================================= */

function getWhyHigher(candidate) {

    const index =
        backendData.findIndex(
            item =>
                item.id === candidate.id
        );


    if (
        index === -1 ||
        index === 0
    ) {

        return `
            <div class="why-higher">

                <h4>
                    Why this candidate is ranked #1
                </h4>

                <p>
                    This candidate has the highest overall
                    match score among the candidates evaluated
                    for this job.
                </p>

            </div>
        `;

    }


    const previous =
        backendData[index - 1];


    const currentScores =
        getScores(candidate);


    const previousScores =
        getScores(previous);


    const currentFinal =
        Number(currentScores.final || 0);


    const previousFinal =
        Number(previousScores.final || 0);


    const difference =
        currentFinal -
        previousFinal;


    if (difference > 0) {

        return `
            <div class="why-higher">

                <h4>
                    Why this candidate is ranked above
                    ${escapeHtml(previous.name || "the previous candidate")}
                </h4>

                <p>
                    ${escapeHtml(candidate.name || "This candidate")}
                    has a ${difference.toFixed(2)} point higher
                    overall match score
                    (${currentFinal.toFixed(2)}%
                    vs
                    ${previousFinal.toFixed(2)}%).
                    The difference comes from the combined
                    ranking factors shown above.
                </p>

            </div>
        `;

    }


    return `
        <div class="why-higher">

            <h4>
                Ranking comparison
            </h4>

            <p>
                This candidate and the previous candidate have
                very similar overall scores. Nexora ranks this
                candidate slightly higher based on the evaluated
                scoring factors.
            </p>

        </div>
    `;

}



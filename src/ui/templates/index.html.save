/* =====================================================
   PAGE NAVIGATION
===================================================== */

function showPage(pageName) {


    const pages =
        document.querySelectorAll(".page");


    pages.forEach(page => {

        page.classList.remove("active");

    });


    const selected =
        document.getElementById(pageName);


    if (selected) {

        selected.classList.add("active");

    }


    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });

}



/* =====================================================
   INTERACTIVE HOME MESSAGE
===================================================== */

function changeMessage() {


    const input =
        document.getElementById("searchInput");


    const message =
        document.getElementById("message");


    const value =
        input.value.trim();


    if (!value) {

        message.textContent =
            "Start with a role. We'll help you find the shortlist.";

        return;

    }


    if (
        value.toLowerCase().includes("software")
    ) {

        message.textContent =
            "Great choice. Let's find engineers who can actually move the product forward.";

    }

    else if (
        value.toLowerCase().includes("data")
    ) {

        message.textContent =
            "Let's find the people who can turn your data into decisions.";

    }

    else if (
        value.toLowerCase().includes("design")
    ) {

        message.textContent =
            "Great design starts with great people. Let's find them.";

    }

    else {

        message.textContent =
            "Good start. Tell us the role — Nexora will handle the shortlist.";

    }

}



/* =====================================================
   SEARCH
===================================================== */

function searchCandidates() {


    const input =
        document.getElementById("searchInput");


    const query =
        input.value.trim();


    if (!query) {

        input.focus();

        document.getElementById("message")
            .textContent =
            "Tell us what role you're hiring for first.";

        return;

    }


    document.getElementById("searchedRole")
        .textContent = query;


    document.getElementById("roleTitle")
        ?.textContent;


    renderCandidates();


    showPage("results");

}



/* =====================================================
   RENDER TOP 3
===================================================== */

function renderCandidates() {


    const topContainer =
        document.getElementById("topCandidates");


    const table =
        document.getElementById("candidateTable");


    topContainer.innerHTML = "";

    table.innerHTML = "";



    /*
       Sort candidates by final score
    */

    const sorted =
        [...backendData]
        .sort(
            (a, b) =>
                b.final_score -
                a.final_score
        );



    /* ============================================
       TOP 3
    ============================================ */

    sorted.slice(0, 3).forEach(
        (candidate, index) => {


            const card =
                document.createElement("div");


            card.className =
                "candidate-card";


            if (index === 0) {

                card.classList.add("first");

            }


            card.innerHTML = `

                <div class="rank">

                    #${index + 1}

                </div>


                <div class="candidate-name">

                    ${candidate.name}

                </div>


                <div class="candidate-role">

                    ${candidate.role}

                </div>


                <div class="score">

                    ${candidate.final_score.toFixed(2)}%

                    <div class="score-label">

                        AI Match Score

                    </div>

                </div>


                <div class="metrics">


                    <div class="metric">

                        <span>
                            Semantic Match
                        </span>

                        <strong>
                            ${candidate.semantic_score.toFixed(2)}%
                        </strong>

                    </div>


                    <div class="metric">

                        <span>
                            Required Skills
                        </span>

                        <strong>
                            ${candidate.required_score.toFixed(2)}%
                        </strong>

                    </div>


                    <div class="metric">

                        <span>
                            Keyword Match
                        </span>

                        <strong>
                            ${candidate.keyword_score.toFixed(2)}%
                        </strong>

                    </div>


                    <div class="metric">

                        <span>
                            Experience
                        </span>

                        <strong>
                            ${candidate.experience_score.toFixed(2)}%
                        </strong>

                    </div>


                </div>


                <div class="skill-list">

                    ${candidate.skills
                        .map(
                            skill =>
                                `<span class="skill">
                                    ${skill}
                                </span>`
                        )
                        .join("")
                    }

                </div>

            `;


            topContainer.appendChild(card);

        }
    );



    /* ============================================
       ALL CANDIDATES
    ============================================ */

    sorted.forEach(
        (candidate, index) => {


            const row =
                document.createElement("div");


            row.className =
                "candidate-row";


            row.innerHTML = `

                <div>
                    #${index + 1}
                </div>


                <div>

                    <strong>
                        ${candidate.name}
                    </strong>

                    <br>

                    <span
                        style="
                            color:#89919f;
                            font-size:10px;
                        "
                    >
                        ${candidate.role}
                    </span>

                </div>


                <div class="row-score">

                    ${candidate.final_score.toFixed(2)}%

                </div>


                <div>

                    ${candidate.required_score.toFixed(2)}%

                </div>


                <div>

                    ${candidate.experience_score.toFixed(2)}%

                </div>

            `;


            table.appendChild(row);

        }
    );



    /* ============================================
       UPDATE DASHBOARD
    ============================================ */

    updateDashboard(sorted);

}



/* =====================================================
   DASHBOARD DATA
===================================================== */

function updateDashboard(candidates) {


    if (!candidates.length) {

        return;

    }


    const highest =
        Math.max(
            ...candidates.map(
                c => c.final_score
            )
        );


    const average =
        candidates.reduce(
            (sum, c) =>
                sum + c.final_score,
            0
        ) / candidates.length;



    document.getElementById(
        "statCandidates"
    ).textContent =
        candidates.length;


    document.getElementById(
        "statHighest"
    ).textContent =
        highest.toFixed(2) + "%";


    document.getElementById(
        "statAverage"
    ).textContent =
        average.toFixed(2) + "%";

}



/* =====================================================
   CONTACT
===================================================== */

function sendMessage() {


    alert(
        "Thank you! The Nexora team will get back to you."
    );

}



/* =====================================================
   INITIALIZE
===================================================== */

renderCandidates();

</script>


</body>

</html>
